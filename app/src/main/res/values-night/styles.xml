<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 夜间启动主题：同 values/styles.xml，不使用系统 SplashScreen 遮罩 -->
    <style name="Theme.Splash" parent="Theme.NewAppTheme">
        <item name="android:windowBackground">@color/colorSplashBg</item>
        <!-- 夜间：启动屏深色底 + 浅色状态栏图标 -->
        <item name="android:statusBarColor">@color/colorSplashBg</item>
        <item name="android:navigationBarColor">@color/colorSplashBg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
